# Supabase project URL (Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase publishable key (sb_publishable_...). The legacy anon key also works here.
# Never put the secret / service-role key in a NEXT_PUBLIC_ variable.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxx

# Public base URL of this app, used to build auth email redirect links.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase secret key (sb_secret_...; the legacy service_role key also works).
# Server-only: used to create and deactivate user accounts. Never prefix with NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=sb_secret_xxxxxxxxxxxxxxxxxxxx
